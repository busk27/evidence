{
  "openapi": "3.1.0",
  "info": {
    "title": "Evidence API",
    "version": "0.1.0",
    "description": "Registro de conversas de discovery B2B. Recebe o despejo de uma conversa, extrai fatos rastreáveis por origem e aponta os campos do perfil da firma que ainda estão vazios. Todo corpo de requisição deve ser JSON em UTF-8; corpo com bytes fora de UTF-8 ou com charset declarado diferente de utf-8 é recusado com 400, nunca gravado."
  },
  "servers": [{ "url": "/" }],
  "paths": {
    "/api/firms": {
      "post": {
        "summary": "Cria uma firma, opcionalmente com um contato",
        "description": "Toda firma nasce com stage = nao-contatada. O corpo não aceita stage nem nenhuma chave fora do schema (400).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json; charset=utf-8": {
              "schema": { "$ref": "#/components/schemas/FirmInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Firma (e contato, se enviado) gravados.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FirmCreated" }
              }
            }
          },
          "400": { "description": "Corpo da requisição inválido: fora de UTF-8, charset diferente de utf-8, JSON malformado, ou fora do schema (inclui tentativa de enviar stage)." },
          "500": { "description": "Erro ao gravar. Se a firma foi gravada e o contato não, o firm_id vem em details." }
        }
      }
    },
    "/api/conversations": {
      "post": {
        "summary": "Grava um despejo de conversa e extrai fatos",
        "description": "Recebe o texto bruto de uma conversa, chama o modelo para extrair fatos, aplica as regras de negócio de qualidade da evidência, e grava fatos e/ou perguntas em aberto. Devolve exatamente o que foi gravado.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json; charset=utf-8": {
              "schema": { "$ref": "#/components/schemas/ConversationInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Conversa gravada. Fatos e/ou perguntas em aberto extraídos.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ConversationResult" }
              }
            }
          },
          "400": { "description": "Corpo da requisição inválido: fora de UTF-8, charset diferente de utf-8, JSON malformado, ou fora do schema." },
          "404": { "description": "firm_id ou contact_id não encontrado." },
          "502": { "description": "Falha ao extrair fatos com o modelo. A conversa já foi gravada; o conversation_id vem em details." }
        }
      }
    },
    "/api/firms/{id}": {
      "get": {
        "summary": "Perfil da firma com os fatos e a origem de cada um",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Perfil da firma.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FirmProfile" }
              }
            }
          },
          "404": { "description": "Firma não encontrada." }
        }
      }
    },
    "/api/firms/{id}/open-questions": {
      "get": {
        "summary": "Perguntas em aberto da firma (para a próxima conversa)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de perguntas com status open.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OpenQuestionsList" }
              }
            }
          },
          "404": { "description": "Firma não encontrada." }
        }
      }
    },
    "/api/facts/{id}/retract": {
      "post": {
        "summary": "Marca um fato como errado, sem apagar",
        "description": "O fato continua no banco com status = wrong e o motivo, mas sai do perfil. Se o campo ficar sem nenhum fato válido e sem pergunta aberta, cria uma open_question com a pergunta do campo (regra 4: campo vazio vira pergunta).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json; charset=utf-8": {
              "schema": {
                "$ref": "#/components/schemas/RetractInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Fato marcado como errado. open_question vem null se o campo ainda tem fato válido ou já tinha pergunta aberta.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RetractResult"
                }
              }
            }
          },
          "400": {
            "description": "id não é uuid, ou corpo inválido (fora de UTF-8, JSON malformado, reason vazio, chave fora do schema)."
          },
          "404": {
            "description": "Fato não encontrado."
          },
          "409": {
            "description": "Fato já está marcado como errado."
          }
        }
      }
    },
    "/api/facts/{id}/correct": {
      "post": {
        "summary": "Corrige um fato: marca o original como errado e grava a versão certa",
        "description": "A versão certa fica no mesmo campo e na mesma conversa do original, com corrects_fact_id apontando para ele. Ela passa pelas mesmas regras de um fato extraído: regra 1 (campo de custo só com stated), regra 2 (gargalo_frase_literal exige verbatim), regra 4 (ausência não é fato) e a trava de verbatim (o verbatim precisa aparecer como fala no despejo da conversa original). Se violar qualquer uma, responde 422 e nada muda. O campo não pode ser trocado.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json; charset=utf-8": {
              "schema": {
                "$ref": "#/components/schemas/CorrectInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Original marcado como errado e versão certa gravada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CorrectResult"
                }
              }
            }
          },
          "400": {
            "description": "id não é uuid, ou corpo inválido (fora de UTF-8, JSON malformado, chave fora do schema, inclusive field ou stage)."
          },
          "404": {
            "description": "Fato não encontrado."
          },
          "409": {
            "description": "Fato já está marcado como errado."
          },
          "422": {
            "description": "A correção viola uma regra de negócio. O motivo vem em error."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProfileField": {
        "type": "string",
        "enum": [
          "interlocutor",
          "decisor_ou_operador",
          "quem_opera_dd",
          "origem_do_contato",
          "tamanho_praca_cliente",
          "volume_dd",
          "entregavel_final",
          "quem_faz_preparacao_hoje",
          "ia_em_uso",
          "gargalo_frase_literal",
          "horas_do_gargalo_por_projeto",
          "de_quem_sao_as_horas",
          "projetos_por_mes",
          "destino_da_hora_economizada",
          "preco_testado",
          "reacao_ao_preco",
          "objecao_principal",
          "shadowing",
          "acesso_data_room",
          "proximo_passo"
        ]
      },
      "FirmStage": {
        "type": "string",
        "enum": [
          "nao-contatada",
          "conversa-marcada",
          "conversa-feita",
          "preco-testado",
          "piloto-proposto",
          "assinou",
          "descartada"
        ],
        "description": "Só muda por ação explícita do usuário. Nenhum endpoint desta API altera stage a partir de texto de conversa."
      },
      "FactConfidence": {
        "type": "string",
        "enum": ["stated", "reported"],
        "description": "stated: dito diretamente por quem vive o fato. reported: repassado por terceiro. Campos de custo (horas_do_gargalo_por_projeto, de_quem_sao_as_horas, projetos_por_mes, destino_da_hora_economizada) só gravam com stated."
      },
      "FirmInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "country": { "type": ["string", "null"] },
          "size": { "type": ["string", "null"] },
          "contact": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "role": { "type": ["string", "null"] },
              "email": { "type": ["string", "null"], "format": "email" }
            }
          }
        }
      },
      "FirmCreated": {
        "type": "object",
        "properties": {
          "firm": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "name": { "type": "string" },
              "country": { "type": ["string", "null"] },
              "size": { "type": ["string", "null"] },
              "stage": { "$ref": "#/components/schemas/FirmStage" },
              "created_at": { "type": "string", "format": "date-time" }
            }
          },
          "contact": {
            "type": ["object", "null"],
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "firm_id": { "type": "string", "format": "uuid" },
              "name": { "type": "string" },
              "role": { "type": ["string", "null"] },
              "email": { "type": ["string", "null"] }
            }
          }
        }
      },
      "ConversationInput": {
        "type": "object",
        "required": ["firm_id", "raw_dump"],
        "properties": {
          "firm_id": { "type": "string", "format": "uuid" },
          "contact_id": { "type": ["string", "null"], "format": "uuid" },
          "happened_on": { "type": "string", "format": "date", "description": "YYYY-MM-DD, default hoje." },
          "raw_dump": { "type": "string", "description": "Texto bruto da conversa, escrito ou ditado logo após a call." }
        }
      },
      "ConversationResult": {
        "type": "object",
        "properties": {
          "conversation": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "firm_id": { "type": "string", "format": "uuid" },
              "contact_id": { "type": ["string", "null"], "format": "uuid" },
              "happened_on": { "type": "string", "format": "date" },
              "created_at": { "type": "string", "format": "date-time" }
            }
          },
          "facts_recorded": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string", "format": "uuid" },
                "field": { "$ref": "#/components/schemas/ProfileField" },
                "statement": { "type": "string" },
                "verbatim": { "type": ["string", "null"] },
                "confidence": { "$ref": "#/components/schemas/FactConfidence" }
              }
            }
          },
          "open_questions_recorded": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string", "format": "uuid" },
                "field": { "$ref": "#/components/schemas/ProfileField" },
                "question": { "type": "string" },
                "status": { "type": "string", "enum": ["open", "answered", "dropped"] }
              }
            }
          }
        }
      },
      "FirmProfile": {
        "type": "object",
        "properties": {
          "firm": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "name": { "type": "string" },
              "country": { "type": ["string", "null"] },
              "size": { "type": ["string", "null"] },
              "stage": { "$ref": "#/components/schemas/FirmStage" },
              "created_at": { "type": "string", "format": "date-time" }
            }
          },
          "facts": {
            "type": "array",
            "description": "Só fatos válidos. Fatos marcados como errados não aparecem.",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string", "format": "uuid" },
                "field": { "$ref": "#/components/schemas/ProfileField" },
                "statement": { "type": "string" },
                "verbatim": { "type": ["string", "null"] },
                "confidence": { "$ref": "#/components/schemas/FactConfidence" },
                "corrects_fact_id": { "type": ["string", "null"], "format": "uuid", "description": "Se este fato é a correção de outro, o id do original (marcado como errado)." },
                "source": {
                  "type": "object",
                  "properties": {
                    "conversation_id": { "type": "string", "format": "uuid" },
                    "happened_on": { "type": ["string", "null"], "format": "date" }
                  }
                }
              }
            }
          }
        }
      },
      "OpenQuestionsList": {
        "type": "object",
        "properties": {
          "firm_id": { "type": "string", "format": "uuid" },
          "open_questions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string", "format": "uuid" },
                "field": { "$ref": "#/components/schemas/ProfileField" },
                "question": { "type": "string" },
                "status": { "type": "string", "enum": ["open", "answered", "dropped"] },
                "created_at": { "type": "string", "format": "date-time" }
              }
            }
          }
        }
      },
      "FactStatus": {
        "type": "string",
        "enum": [
          "valid",
          "wrong"
        ],
        "description": "Fato nunca é editado nem apagado. wrong: marcado como errado pelo usuário, sai do perfil, continua no banco com o motivo."
      },
      "RetractInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "Por que o fato está errado."
          }
        }
      },
      "CorrectInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reason",
          "statement",
          "confidence"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "Por que o original está errado."
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "verbatim": {
            "type": [
              "string",
              "null"
            ],
            "description": "Só trecho que o despejo marca como fala do interlocutor (aspas, ou logo depois de \"ele disse que\", \"ele falou assim\", \"nas palavras dele\", \"com essas palavras\")."
          },
          "confidence": {
            "$ref": "#/components/schemas/FactConfidence"
          }
        }
      },
      "RevisedFact": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "field": {
            "$ref": "#/components/schemas/ProfileField"
          },
          "statement": {
            "type": "string"
          },
          "verbatim": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "$ref": "#/components/schemas/FactConfidence"
          },
          "status": {
            "$ref": "#/components/schemas/FactStatus"
          },
          "status_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "status_changed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "corrects_fact_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "RetractResult": {
        "type": "object",
        "properties": {
          "fact": {
            "$ref": "#/components/schemas/RevisedFact"
          },
          "open_question": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "field": {
                "$ref": "#/components/schemas/ProfileField"
              },
              "question": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "open"
                ]
              }
            }
          }
        }
      },
      "CorrectResult": {
        "type": "object",
        "properties": {
          "original": {
            "$ref": "#/components/schemas/RevisedFact"
          },
          "fact": {
            "$ref": "#/components/schemas/RevisedFact"
          }
        }
      }
    }
  }
}
