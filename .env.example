# Copie para .env.local e preencha com valores reais. Nunca commitar .env.local.

# Supabase — Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Chave publicável (sb_publishable_...), ou a "anon" legada. Usada só no servidor, para login e sessão.
SUPABASE_PUBLISHABLE_KEY=

# Supabase — Project Settings > Database > Connection string (URI). Só para rodar a migration por script.
SUPABASE_DB_URL=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
